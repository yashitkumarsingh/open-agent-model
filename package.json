{
  "name": "open-agent-model",
  "version": "0.2.1",
  "description": "An open Agent-BOM, threat model, and CI policy gate for AI agents and MCP-connected systems.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "oam": "./dist/index.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "tsc && node ./dist/index.js",
    "test": "npm run build && npm run test:compiled",
    "test:compiled": "node --import tsx --test test/**/*.test.ts",
    "coverage": "npm run build && npm run coverage:compiled",
    "coverage:compiled": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 test/**/*.test.ts",
    "precommit": "node scripts/precommit.js",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "agent",
    "governance",
    "mcp",
    "threat-modelling",
    "abom"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "husky": "^9.1.7",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  }
}
