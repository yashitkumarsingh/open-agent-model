{
  "name": "open-agent-model",
  "version": "0.1.0",
  "description": "An open-source modelling language and visual tool for designing, simulating, auditing, and governing AI agent systems.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "oam": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "tsc && node ./dist/index.js",
    "test": "node --import tsx test/runner.test.ts",
    "precommit": "node scripts/precommit.js",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "agent",
    "governance",
    "mcp",
    "threat-modelling",
    "simulation",
    "abom"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  }
}
