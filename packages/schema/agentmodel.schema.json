{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAgentModel",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  },
  "properties": {
    "system": {
      "type": "string",
      "minLength": 1,
      "description": "The name of the agentic system."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "The version of the system definition."
    },
    "models": {
      "type": "array",
      "description": "Catalog of LLMs and language models approved for use in the system.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id",
            "description": "Unique model ID."
          },
          "provider": {
            "type": "string",
            "description": "Provider (e.g. openai, anthropic, google, local)."
          },
          "deployment": {
            "type": "string",
            "description": "Deployment name or endpoint target."
          },
          "allowed_for": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "List of agent IDs allowed to use this model."
          },
          "data_retention": {
            "type": "string",
            "enum": ["enabled", "disabled"],
            "description": "Whether training data retention is enabled on the model gateway."
          },
          "region": {
            "type": "string",
            "description": "Geographical compute zone of the model deployment."
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Risk profile associated with the model's policy compliance or provider type."
          }
        },
        "required": ["id", "provider", "risk"]
      }
    },
    "identities": {
      "type": "array",
      "description": "Credentials, roles, and authorization accounts used by the agents or tools.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id",
            "description": "Unique identity ID."
          },
          "type": {
            "type": "string",
            "description": "Type of identity (e.g., service_account, user, api_key, jwt)."
          },
          "owner": {
            "type": "string",
            "description": "Owner or custodian team."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO date string when these credentials expire."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Granted authorization scopes."
          },
          "provider_ref": {
            "type": "string",
            "description": "Federated IAM provider reference pointer (e.g. AWS ARN, Snowflake integration ref)."
          },
          "max_session_duration": {
            "type": "integer",
            "description": "Maximum session lifespan in seconds for federated tokens."
          }
        },
        "required": ["id", "type"]
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id",
            "description": "Unique identifier of the agent."
          },
          "purpose": {
            "type": "string",
            "description": "The core purpose or goal of the agent."
          },
          "model": {
            "$ref": "#/$defs/id",
            "description": "Model catalog ID this agent is expected to use."
          },
          "framework": {
            "type": "string",
            "description": "The framework used (e.g. langgraph, autogen, crewai)."
          },
          "autonomy": {
            "type": "string",
            "enum": ["autonomous", "supervised", "human-approval-required", "semi-autonomous"],
            "description": "Autonomy level of the agent."
          },
          "memory": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["vector", "key-value", "relational", "cache", "none"]
              },
              "contains": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "description": "Data classes or contents stored in memory."
              },
              "write_access": {
                "type": "boolean",
                "description": "Whether the agent has runtime write access to memory."
              },
              "poisoning_protection": {
                "type": "boolean",
                "description": "Whether checks are run to prevent injection/poisoning of memory."
              }
            },
            "required": ["type"]
          },
          "allowed_tools": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "List of tool IDs this agent can invoke."
          },
          "denied_tools": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "List of tool IDs explicitly blocked for this agent."
          },
          "approval_required_for": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Actions or tools requiring human-in-the-loop approval before executing."
          },
          "allowed_delegates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Other agent IDs this agent is allowed to delegate tasks to."
          },
          "retry_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_retries": {
                "type": "integer"
              },
              "loop_detection": {
                "type": "boolean"
              },
              "failure_handling": {
                "type": "string"
              }
            }
          },
          "spend_limit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_cost_usd": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "time_window": {
                "type": "string"
              }
            }
          }
        },
        "required": ["id", "purpose"]
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "type": "string",
            "description": "Type of tool (e.g. api, payment_api, database, read_file, write_file, web_search, command_line)."
          },
          "description": {
            "type": "string"
          },
          "data_classes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Data classes this tool accesses or manipulates."
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "requires_human_approval": {
            "type": "boolean"
          },
          "side_effect": {
            "type": "string",
            "enum": ["read", "external_write", "payout", "system_alteration"],
            "description": "Operational impact profile of tool execution."
          },
          "auth_identity": {
            "$ref": "#/$defs/id",
            "description": "The credentials ID referenced to perform authentication."
          },
          "required_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Identity scopes required to invoke this tool."
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["none", "human", "multi-party"]
              },
              "approver_role": {
                "type": "string"
              },
              "expiry_seconds": {
                "type": "integer"
              }
            },
            "required": ["mode"]
          },
          "rate_limit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_calls_per_task": {
                "type": "integer"
              }
            },
            "required": ["max_calls_per_task"]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "description": "Provenance metadata for MCP-imported tools.",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["mcp", "internal", "external"],
                "description": "Origin type of this tool definition."
              },
              "mcp_server": {
                "$ref": "#/$defs/id",
                "description": "ID of the MCP server this tool was discovered from."
              },
              "original_name": {
                "type": "string",
                "description": "Original tool name as returned by the MCP tools/list response."
              }
            },
            "required": ["kind"]
          },
          "input_schema": {
            "type": "object",
            "description": "JSON Schema describing the tool input parameters (from MCP tools/list inputSchema)."
          },
          "annotations": {
            "type": "object",
            "additionalProperties": false,
            "description": "MCP tool behaviour hints for destructiveness, idempotency, and read-only status.",
            "properties": {
              "destructive_hint": {
                "type": "boolean",
                "description": "True if this tool may have destructive side effects."
              },
              "read_only_hint": {
                "type": "boolean",
                "description": "True if this tool only reads data and has no side effects."
              },
              "idempotent_hint": {
                "type": "boolean",
                "description": "True if calling this tool multiple times produces the same result."
              }
            }
          }
        },
        "required": ["id", "type"]
      }
    },
    "mcp_servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "trust_level": {
            "type": "string",
            "enum": ["internal", "partner", "external", "untrusted"]
          },
          "exposes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Tool IDs exposed by this MCP server."
          }
        },
        "required": ["id", "trust_level"]
      }
    },
    "data_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "sensitivity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "classification": {
            "type": "string",
            "enum": ["pii", "financial", "credentials", "internal_data", "public"]
          },
          "inherits_from": {
            "$ref": "#/$defs/id",
            "description": "ID of another data class this data class inherits classification rules from."
          }
        },
        "required": ["id", "sensitivity", "classification"]
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "agent.autonomy": {
                    "type": "string"
                  },
                  "tool.risk": {
                    "type": "string"
                  }
                }
              },
              "require": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tool.requires_human_approval": {
                    "type": "boolean"
                  },
                  "agent.spend_limit.max_cost_usd": {
                    "type": "number"
                  }
                }
              }
            },
            "required": ["id", "severity", "when", "require"]
          }
        ]
      }
    }
  },
  "required": ["system", "version", "agents"]
}
