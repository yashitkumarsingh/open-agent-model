{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAgentModelRuntimeEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "observed_at", "source"],
  "properties": {
    "system": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the system being observed"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO date-time when this observation snapshot was generated"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Source of trace data (e.g., otel, jsonl, langsmith, manual)"
    },
    "observed_agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "trace_id", "span_id"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_model_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "model_id", "trace_id", "span_id"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "model_id": { "type": "string", "minLength": 1 },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "tool_id", "trace_id", "span_id"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "tool_id": { "type": "string", "minLength": 1 },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "delegate_id", "trace_id", "span_id"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "delegate_id": { "type": "string", "minLength": 1 },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_mcp_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "mcp_server_id", "tool_id", "trace_id", "span_id"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "mcp_server_id": { "type": "string", "minLength": 1 },
          "tool_id": { "type": "string", "minLength": 1 },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_approval_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "tool_id", "approver", "decision", "trace_id", "span_id"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "tool_id": { "type": "string", "minLength": 1 },
          "approver": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "enum": ["approved", "denied"] },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_identities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity_id", "trace_id", "span_id"],
        "properties": {
          "identity_id": { "type": "string", "minLength": 1 },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observed_data_access": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "data_class_id", "access_type", "trace_id", "span_id"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "data_class_id": { "type": "string", "minLength": 1 },
          "access_type": { "type": "string", "enum": ["read", "write"] },
          "trace_id": { "type": "string", "minLength": 1 },
          "span_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
